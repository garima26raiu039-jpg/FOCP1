int diagonalSum(int** mat, int matSize, int* matColSize) {
    int sum = 0;
    
    for (int i = 0; i < matSize; i++) {
        // Add primary diagonal element (row == col)
        sum += mat[i][i];
        
        // Add secondary diagonal element (row + col == matSize - 1)
        sum += mat[i][matSize - 1 - i];
    }
    
    // If the matrix size is odd, the center element was added twice
    if (matSize % 2 == 1) {
        sum -= mat[matSize / 2][matSize / 2];
    }
    
    return sum;
}
