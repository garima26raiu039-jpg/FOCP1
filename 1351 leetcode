int countNegatives(int** grid, int gridSize, int* gridColSize) {
    int m = gridSize;
    int n = gridColSize[0];
    
    int row = 0;
    int col = n - 1;
    int count = 0;
    
    while (row < m && col >= 0) {
        if (grid[row][col] < 0) {
            // All elements below grid[row][col] in this column are also negative
            count += (m - row);
            col--; // Move left
        } else {
            row++; // Move down
        }
    }
    
    return count;
}
