#include <stdio.h>

int main()
{
    int mat[3][3];
    int i, j, sum = 0;

    printf("Enter 9 elements:\n");

    for(i = 0; i < 3; i++)
    {
        for(j = 0; j < 3; j++)
        {
            scanf("%d", &mat[i][j]);
        }
    }

    printf("Matrix is:\n");

    for(i = 0; i < 3; i++)
    {
        for(j = 0; j < 3; j++)
        {
            printf("%d ", mat[i][j]);
        }
        printf("\n");
    }

    for(i = 0; i < 3; i++)
    {
        sum = sum + mat[i][i];
    }

    printf("Sum of diagonal elements = %d", sum);

    return 0;
}
